FROM tensorflow/tensorflow:2.15.0

WORKDIR /app

# Keep the exporter compatible with the project's MLflow 2.10 model registry.
RUN pip install --no-cache-dir \
    --ignore-installed blinker \
    "mlflow==2.10.0" \
    "SQLAlchemy==2.0.54" \
    "catboost==1.2.10" \
    "pandas==2.3.3" \
    "pyarrow==15.0.2" \
    "protobuf==4.23.4"

COPY serving/export_catboost_tf_savedmodel.py /app/serving/export_catboost_tf_savedmodel.py
COPY src/features/ /app/src/features/
COPY src/utils/ /app/src/utils/

ENV PYTHONPATH=/app
ENV TF_CPP_MIN_LOG_LEVEL=2

ENTRYPOINT ["python", "/app/serving/export_catboost_tf_savedmodel.py"]
