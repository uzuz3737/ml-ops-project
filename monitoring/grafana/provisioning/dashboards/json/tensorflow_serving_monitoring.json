      "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=\":tensorflow:serving:request_latency_bucket\",model_name=\"CreditCardDefaultCatBoost\",API=\"predict\"}[5m]))) / 1e6", "legendFormat": "p50", "refId": "A"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=\":tensorflow:serving:request_latency_bucket\",model_name=\"CreditCardDefaultCatBoost\",API=\"predict\"}[5m]))) / 1e6", "legendFormat": "p95", "refId": "B"}, {"expr": "histogram_quantile(0.99, sum by (le) (rate({__name__=\":tensorflow:serving:request_latency_bucket\",model_name=\"CreditCardDefaultCatBoost\",API=\"predict\"}[5m]))) / 1e6", "legendFormat": "p99", "refId": "C"}],
