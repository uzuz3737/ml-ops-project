      "targets": [{"expr": "100 * sum(rate({__name__=\":tensorflow:serving:request_count\",model_name=\"CreditCardDefaultCatBoost\",status!=\"OK\"}[5m])) / clamp_min(sum(rate({__name__=\":tensorflow:serving:request_count\",model_name=\"CreditCardDefaultCatBoost\"}[5m])), 1e-9)", "refId": "A"}],
      "title": "Request Error Rate",
